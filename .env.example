# Copy this file to `.env` (same folder) and fill in your real values.
# The optimizer GUI/CLI reads these to pull projections from Supabase.
#
# Get these from the Supabase dashboard → Project Settings → API:
#   SUPABASE_URL      = the Project URL (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_KEY = the service_role key (or the anon key — read-only is fine)

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
